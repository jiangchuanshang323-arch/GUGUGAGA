  "lines": [
    {
      "mode": "适应",
      "text": "第一张处方叫适应：早发现、早预警、早行动。",
      "start": 2.0,
      "speech_end": 5.8938749999999995,
      "end": 6.023874999999999
    },
    {
      "mode": "监测",
      "text": "先看官方监测，再查本地预警的地区和有效时间。",
      "start": 6.023875,
      "speech_end": 10.298666666666666,
      "end": 10.428666666666667
    },
    {
      "mode": "行动",
      "text": "最后按指引准备应急物品，调整出行和用水安排。",
      "start": 10.428666666666667,
      "speech_end": 14.700333333333333,
      "end": 14.830333333333334
    },
    {
      "mode": "损失",
      "text": "这是在减少暴露与损失，不是在消灭厄尔尼诺。",
      "start": 14.830333333333332,
      "speech_end": 18.664499999999997,
      "end": 18.794499999999996
    },
    {
      "mode": "减缓",
      "text": "第二张处方叫减缓：通过节能和清洁能源，减少温室气体排放，限制长期人为增暖。",
      "start": 20.7945,
      "speech_end": 27.94025,
      "end": 28.070249999999998
    },
    {
      "mode": "自然",
      "text": "它不能阻止自然发生的厄尔尼诺。",
      "start": 28.070249999999998,
      "speech_end": 30.249333333333333,
      "end": 30.37933333333333
    },
    {
      "mode": "区分",
      "text": "注意：备应急包属于适应，关掉不用的灯属于减缓，别混成一类。",
      "start": 30.37933333333333,
      "speech_end": 35.6075,
      "end": 35.737500000000004
    },
    {
      "mode": "选择",
      "text": "今天选一件事：和家人检查应急包，或者完成一次节能行动。你选哪一项？",
      "start": 35.7375,
      "speech_end": 42.305,
      "end": 42.435
    },
    {
      "mode": "记录",
      "text": "把选择写下来，再说说它属于哪一类。",
      "start": 45.434999999999995,
      "speech_end": 48.497791666666664,
      "end": 48.94779166666667
    }
