[
  {
    "id": 0,
    "text": "先分清两股气流：近海面的东风信风，从东向西吹，也就是从右向左。",
    "mode": "信风",
    "start": 0,
    "end": 5.916083333333333
  },
  {
    "id": 1,
    "text": "上面这根箭头是高空回流，从西向东。它不是信风。",
    "mode": "高空",
    "start": 5.916083333333333,
    "end": 10.839333333333332
  },
  {
    "id": 2,
    "text": "正常时，西侧暖水厚",
    "mode": "正常",
    "start": 10.839333333333332,
    "end": 13.064001811594196
  },
  {
    "id": 3,
    "text": "空气上升",
    "mode": "正常",
    "start": 13.064001811594196,
    "end": 13.931632246376807
  },
  {
    "id": 4,
    "text": "东侧冷水上涌",
    "mode": "正常",
    "start": 13.931632246376807,
    "end": 15.498077898550719
  },
  {
    "id": 5,
    "text": "空气下沉",
    "mode": "正常",
    "start": 15.498077898550719,
    "end": 16.445708333333336
  },
  {
    "id": 6,
    "text": "当东风信风减弱",
    "mode": "减弱",
    "start": 16.445708333333332,
    "end": 17.86803125000002
  },
  {
    "id": 7,
    "text": "暖水向东扩展",
    "mode": "减弱",
    "start": 17.86803125000002,
    "end": 19.50145089285721
  },
  {
    "id": 8,
    "text": "东部温跃层加深",
    "mode": "减弱",
    "start": 19.50145089285721,
    "end": 20.81377380952384
  },
  {
    "id": 9,
    "text": "冷水上涌受到抑制",
    "mode": "减弱",
    "start": 20.81377380952384,
    "end": 22.675
  },
  {
    "id": 10,
    "text": "中东太平洋持续异常增暖，这就是厄尔尼诺现象。",
    "mode": "定义",
    "start": 22.674999999999997,
    "end": 26.962083333333332
  },
  {
    "id": 11,
    "text": "对流和降雨区域随之东移",
    "mode": "大气",
    "start": 26.962083333333332,
    "end": 29.297982843137277
  },
  {
    "id": 12,
    "text": "沃克环流减弱",
    "mode": "大气",
    "start": 29.297982843137277,
    "end": 30.780291666666667
  },
  {
    "id": 13,
    "text": "海温差缩小",
    "mode": "反馈",
    "start": 30.780291666666667,
    "end": 32.04417361111118
  },
  {
    "id": 14,
    "text": "又会进一步削弱信风",
    "mode": "反馈",
    "start": 32.04417361111118,
    "end": 33.733161111111094
  },
  {
    "id": 15,
    "text": "海洋与大气互相推动，形成正反馈。",
    "mode": "反馈",
    "start": 33.733161111111094,
    "end": 37.693583333333336
  }
]