[
  {
    "mode": "回扣",
    "text": "先揭晓预测。关键是气流在哪里升降。",
    "start": 0.2,
    "speech_end": 3.6668333333333334,
    "end": 3.7668333333333335
  },
  {
    "mode": "西侧",
    "text": "印尼一侧，上升对流减弱，降水偏少，干旱风险增加。",
    "start": 3.7668333333333335,
    "speech_end": 8.611958333333334,
    "end": 8.711958333333333
  },
  {
    "mode": "东侧",
    "text": "对流和降雨向东移动。强事件中，偏多降雨可延伸到秘鲁北部沿岸。",
    "start": 8.711958333333333,
    "speech_end": 14.898458333333334,
    "end": 14.998458333333334
  },
  {
    "mode": "整体",
    "text": "自然环境具有整体性，牵一发而动全身。",
    "start": 14.998458333333334,
    "speech_end": 18.254541666666668,
    "end": 18.35454166666667
  },
  {
    "mode": "五牌",
    "text": "下面沿着水、气、生、土、地形五张牌，追踪这场环境多米诺。",
    "start": 18.35454166666667,
    "speech_end": 24.14354166666667,
    "end": 24.243541666666673
  },
  {
    "mode": "选水",
    "text": "先翻开第一张，水。环流改变，让降水重新分配。",
    "start": 24.243541666666673,
    "speech_end": 29.06091666666667,
    "end": 29.160916666666672
  },
  {
    "mode": "全球",
    "text": "这张官方图，展示十二月到二月厄尔尼诺的典型影响。",
    "start": 29.160916666666672,
    "speech_end": 33.45720833333334,
    "end": 33.55720833333334
  },
  {
    "mode": "偏干",
    "text": "先找印尼一带，偏干；原本湿润的地方，干旱风险可能增加。",
    "start": 33.55720833333334,
    "speech_end": 38.798416666666675,
    "end": 38.89841666666668
  },
  {
    "mode": "偏湿",
    "text": "赤道中东太平洋偏暖、偏湿；影响还要看季节和事件强度。",
    "start": 38.89841666666668,
    "speech_end": 44.00191666666667,
    "end": 44.101916666666675
  },
  {
    "mode": "少雨",
    "text": "降雨的变化，还会传到河流。持续少雨，雨水补给减少，缺水风险增加。",
    "start": 44.101916666666675,
    "speech_end": 50.71587500000001,
    "end": 50.81587500000001
  },
  {
    "mode": "强雨",
    "text": "强降雨集中，地表径流可能迅速增加，洪涝风险上升。",
    "start": 50.81587500000001,
    "speech_end": 55.360583333333345,
    "end": 55.460583333333346
  },
  {
    "mode": "风险",
    "text": "一些地区要防旱，另一些地区要防涝。",
    "start": 55.460583333333346,
    "speech_end": 58.20620833333334,
    "end": 58.306208333333345
  },
  {
    "mode": "承下",
    "text": "记住：环流变化，降水重分配，再影响水循环。",
    "start": 58.306208333333345,
    "speech_end": 62.71829166666668,
    "end": 63.01829166666668
  }
]