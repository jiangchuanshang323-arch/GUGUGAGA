[
  {
    "mode": "信风",
    "text": "先分清两股气流：近海面的东风信风，从东向西吹，也就是从右向左。",
    "start": 0,
    "speech_end": 5.816083333333333,
    "end": 5.916083333333333
  },
  {
    "mode": "高空",
    "text": "上面这根箭头是高空回流，从西向东。它不是信风。",
    "start": 5.916083333333333,
    "speech_end": 10.739333333333333,
    "end": 10.839333333333332
  },
  {
    "mode": "正常",
    "text": "正常时，西侧暖水厚、空气上升；东侧冷水上涌，空气下沉。",
    "start": 10.839333333333332,
    "speech_end": 16.345708333333334,
    "end": 16.445708333333336
  },
  {
    "mode": "减弱",
    "text": "当东风信风减弱，暖水向东扩展，东部温跃层加深，冷水上涌受到抑制。",
    "start": 16.445708333333332,
    "speech_end": 22.575,
    "end": 22.675
  },
  {
    "mode": "定义",
    "text": "中东太平洋持续异常增暖，这就是厄尔尼诺现象。",
    "start": 22.674999999999997,
    "speech_end": 26.86208333333333,
    "end": 26.962083333333332
  },
  {
    "mode": "大气",
    "text": "对流和降雨区域随之东移，沃克环流减弱。",
    "start": 26.962083333333332,
    "speech_end": 30.680291666666665,
    "end": 30.780291666666667
  },
  {
    "mode": "反馈",
    "text": "海温差缩小，又会进一步削弱信风。海洋与大气互相推动，形成正反馈。",
    "start": 30.780291666666667,
    "speech_end": 37.343583333333335,
    "end": 37.693583333333336
  }
]